{
	"name": "course-captain/course-captain",
	"description": "Course Captain – neutral learning management for WordPress (Free core).",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://wordpress.org/plugins/course-captain/",
	"require": {
		"php": ">=8.5"
	},
	"require-dev": {
		"brain/monkey": "^2.7",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/wordpress-stubs": "^7.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6",
		"roots/wordpress-no-content": "7.1.5",
		"squizlabs/php_codesniffer": "^3.13",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"wp-cli/config-command": "^2.3",
		"wp-cli/core-command": "^2.1",
		"wp-cli/entity-command": "^2.8",
		"wp-cli/extension-command": "^2.1",
		"wp-cli/i18n-command": "^2.6",
		"wp-cli/wp-cli": "^2.12",
		"wp-coding-standards/wpcs": "^3.4",
		"wp-phpunit/wp-phpunit": "7.1.3",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"autoload": {
		"psr-4": {
			"CourseCaptain\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"CourseCaptain\\Tests\\Integration\\": "tests/integration/",
			"CourseCaptain\\Tests\\Support\\": "tests/support/",
			"CourseCaptain\\Tests\\Unit\\": "tests/unit/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.5.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:bootstrap-compat": "phpcs --standard=tools/qa/phpcs-bootstrap-compat.xml",
		"analyse": "phpstan analyse --no-progress --memory-limit=1G",
		"test": "phpunit --configuration phpunit.xml.dist",
		"test:integration": "phpunit --configuration phpunit-integration.xml.dist",
		"test:integration-ms": "phpunit --configuration phpunit-integration-multisite.xml.dist",
		"test:cli-ms002": "bash tests/integration/cli/ms-002-network-activate.sh",
		"guard:free": "@php tests/guards/free-guard.php",
		"guard:free-selftest": "@php tests/guards/free-guard.php --self-test",
		"guard:textdomain": "@php tests/guards/textdomain-lint.php"
	}
}
