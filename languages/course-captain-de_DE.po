#: src/Admin/RiskDialog.php:74
msgid "Switch groups off"
msgstr "Gruppen ausschalten"

#: src/Admin/RiskDialog.php:78
msgid "Switch message off?"
msgstr "Nachricht ausschalten?"

#: src/Admin/RiskDialog.php:79
msgid "Learners no longer receive this message. Already planned messages of this type are not sent."
