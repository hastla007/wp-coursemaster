msgstr "Reiner Text wird von manchen Mailprogrammen und Screenreadern am besten gelesen."

#: src/Admin/SettingsFields.php:822
msgid "HTML with text version"
msgstr "HTML mit Textversion"

#: src/Admin/SettingsFields.php:823
msgid "Text only"
msgstr "Nur Text"

#: src/Admin/SettingsFields.php:827
