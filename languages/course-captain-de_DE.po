#: src/Import/ImportReport.php:332
msgid "Correct the course after the import and publish it in the editor, or fix the package and import it again."
msgstr "Korrigiere den Kurs nach dem Import und veröffentliche ihn im Editor, oder korrigiere das Paket und importiere es erneut."

#: src/Import/ImportReport.php:336
msgid "The record does not match the package format."
msgstr "Der Datensatz entspricht nicht dem Paketformat."

#: src/Import/ImportReport.php:336
msgid "Correct the record in the source system and export the package again."
msgstr "Korrigiere den Datensatz im Quellsystem und exportiere das Paket erneut."

#: src/Import/ImportReport.php:338
msgid "The question type is not available on this site."
msgstr "Der Fragetyp ist auf dieser Website nicht verfügbar."

#: src/Import/ImportReport.php:338
msgid "Activate the extension that provides the question type, then import again."
msgstr "Aktiviere die Erweiterung, die den Fragetyp bereitstellt, und importiere dann erneut."

#: src/Import/ImportReport.php:340
msgid "The object ID occurs more than once in the package."
msgstr "Die Objekt-ID kommt im Paket mehrfach vor."

#: src/Import/ImportReport.php:340
msgid "Give every object a unique ID in the source system."
msgstr "Gib jedem Objekt im Quellsystem eine eindeutige ID."

#: src/Import/ImportReport.php:342
msgid "The object refers to another object that is neither in the package nor on this site."
msgstr "Das Objekt verweist auf ein anderes Objekt, das weder im Paket noch auf dieser Website vorhanden ist."

#: src/Import/ImportReport.php:342
msgid "Add the referenced object to the package or remove the reference."
msgstr "Füge das referenzierte Objekt dem Paket hinzu oder entferne den Verweis."

#: src/Import/ImportReport.php:344
msgid "The record was changed after the package was created (checksum differs)."
msgstr "Der Datensatz wurde nach dem Erstellen des Pakets geändert (Prüfsumme abweichend)."

#: src/Import/ImportReport.php:344
msgid "Export the package again from the source system."
msgstr "Exportiere das Paket erneut aus dem Quellsystem."

#: src/Import/ImportReport.php:346
msgid "The object depends on another object that could not be imported."
msgstr "Das Objekt hängt von einem anderen Objekt ab, das nicht importiert werden konnte."

#: src/Import/ImportReport.php:346
msgid "Fix the object it depends on; this object is imported with it."
msgstr "Korrigiere das Objekt, von dem es abhängt; dieses Objekt wird dann mit importiert."

#: src/Import/ImportReport.php:348
msgid "The object could not be saved."
msgstr "Das Objekt konnte nicht gespeichert werden."

#: src/Import/ImportReport.php:348
msgid "Check the object in the source system and import the package again."
msgstr "Prüfe das Objekt im Quellsystem und importiere das Paket erneut."

#: src/Import/ImportReport.php:350
msgid "Too many objects failed, so the import was stopped."
msgstr "Zu viele Objekte sind fehlgeschlagen, deshalb wurde der Import angehalten."

#: src/Import/ImportReport.php:350
msgid "Look for a common cause in the report, fix it and import again."
msgstr "Suche im Bericht nach einer gemeinsamen Ursache, behebe sie und importiere erneut."

#: src/Import/ImportReport.php:352
msgid "The import was cancelled."
msgstr "Der Import wurde abgebrochen."

#: src/Import/ImportReport.php:352
msgid "Discard the import or resume it."
msgstr "Verwirf den Import oder setze ihn fort."

#: src/Import/ImportReport.php:355
msgid "The import stopped responding."
msgstr "Der Import reagiert nicht mehr."

#: src/Import/ImportReport.php:355
msgid "Resume the import."
msgstr "Setze den Import fort."

#: src/Import/ImportReport.php:357
msgid "The database was temporarily unavailable."
msgstr "Die Datenbank war vorübergehend nicht verfügbar."

#: src/Import/ImportReport.php:357
msgid "The import resumes automatically; otherwise resume it."
msgstr "Der Import wird automatisch fortgesetzt; andernfalls setze ihn fort."

#: src/Import/ImportReport.php:359
msgid "A newer import of the same source was activated in the meantime."
msgstr "Inzwischen wurde ein neuerer Import derselben Quelle aktiviert."

#: src/Import/ImportReport.php:359
msgid "Discard this import."
msgstr "Verwirf diesen Import."

#: src/Import/ImportReport.php:361
msgid "The stored package copy is missing or was changed."
msgstr "Die gespeicherte Paketkopie fehlt oder wurde verändert."

#: src/Import/ImportReport.php:361
msgid "Upload and validate the package again."
msgstr "Lade das Paket hoch und validiere es erneut."

#: src/Import/ImportReport.php:363
msgid "The person who approved the import no longer has the required rights."
msgstr "Die Person, die den Import freigegeben hat, hat die nötigen Rechte nicht mehr."

#: src/Import/ImportReport.php:363
msgid "Approve and start the import again with an account that may publish courses."
msgstr "Gib den Import mit einem Konto, das Kurse veröffentlichen darf, erneut frei und starte ihn."

#: src/Import/ImportReport.php:365
msgid "The import stopped because of an unexpected error."
msgstr "Der Import wurde wegen eines unerwarteten Fehlers angehalten."

#: src/Import/ImportReport.php:365
msgid "Resume the import; if it stops again, contact support with the report."
msgstr "Setze den Import fort; wenn er erneut anhält, wende dich mit dem Bericht an den Support."

