msgstr "Text unter dem Unterschriftsbereich, zum Beispiel eine Funktion."

#: src/Admin/SettingsFields.php:804
msgid "Sender name (optional)"
msgstr "Absendername (optional)"

#: src/Admin/SettingsFields.php:805
