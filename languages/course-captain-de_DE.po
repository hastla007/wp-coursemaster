msgid "Elementor \"Element Caching\" is active."
msgstr "Elementor „Element Caching“ ist aktiv."

#: src/Ops/Compatibility.php:717
msgid "Elementor \"Element Caching\" may be active by default."
msgstr "Elementor „Element Caching“ ist möglicherweise standardmäßig aktiv."

